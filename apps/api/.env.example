# ILMORA API — environment configuration
# Copy to .env (development) or provide through the deployment secret store. Never commit real values.

NODE_ENV=development
PORT=4000
# api | worker | all  (all = HTTP API + queue workers in one process; production runs them separately)
APP_ROLE=all
LOG_LEVEL=info

PUBLIC_API_URL=http://localhost:4000
PUBLIC_WEB_URL=http://localhost:3000
# Exact origins allowed by CORS, comma separated. Required in production, no wildcards.
CORS_ORIGINS=http://localhost:3000
# Express trust proxy: 1 behind nginx, "loopback" when exposed directly
TRUST_PROXY=loopback
API_GLOBAL_PREFIX=v1

# PostgreSQL (runtime role). DATABASE_MIGRATE_URL may point at an owner role for `prisma migrate deploy`.
DATABASE_URL=postgresql://ilmora:ilmora@localhost:5432/ilmora?schema=public
#DATABASE_MIGRATE_URL=
DATABASE_POOL_MAX=10

# Redis for BullMQ queues + pub/sub. The instance MUST run with maxmemory-policy=noeviction (see infra/redis).
REDIS_URL=redis://localhost:6379/0
# Optional second Redis for throttling / caches (eviction allowed). Defaults to REDIS_URL.
#REDIS_CACHE_URL=redis://localhost:6379/1
REDIS_KEY_PREFIX=ilmora

# Secrets — generate with: node -e "console.log(require('crypto').randomBytes(48).toString('base64'))"
JWT_ACCESS_SECRET=change-me-change-me-change-me-change-me-change-me
JWT_ACCESS_TTL_SECONDS=900
REFRESH_TOKEN_TTL_DAYS=30
#COOKIE_DOMAIN=.ilmora.uz
# Must be true in production (HTTPS only cookies)
COOKIE_SECURE=false
OTP_JOB_ENCRYPTION_KEY=change-me-change-me-change-me-change-me
# Authenticator-app secrets of the ministry and the Super Admins (openssl rand -base64 32). Optional in development.
TOTP_ENCRYPTION_KEY=change-me-change-me-change-me-change-me
# Key of graduate card ids for companies (Н-6); unset — derived from JWT_ACCESS_SECRET.
CARD_ID_SECRET=change-me-change-me-change-me-change-me

OTP_TTL_SECONDS=300
OTP_LENGTH=6
OTP_MAX_ATTEMPTS=5
OTP_PHONE_LIMIT=3
OTP_PHONE_WINDOW_SECONDS=600
# Development only: with SMS_PROVIDER=console the code is returned in the API response
OTP_DEV_ECHO=true

# SMS: console (dev), eskiz (notify.eskiz.uz), http (generic JSON POST)
SMS_PROVIDER=console
# Demo/staging only: allow the console provider in production (messages are logged, never sent)
#SMS_ALLOW_CONSOLE_IN_PRODUCTION=true
SMS_SENDER=ILMORA
ESKIZ_BASE_URL=https://notify.eskiz.uz/api
#ESKIZ_EMAIL=
#ESKIZ_PASSWORD=
#SMS_HTTP_URL=
#SMS_HTTP_TOKEN=

DEFAULT_TENANT_SLUG=ilmora
SCHEDULE_TIMEZONE=Asia/Tashkent
SESSION_HORIZON_DAYS=28
ATTENDANCE_TOKEN_GRACE_MINUTES=30

# Payme Merchant API (cash register credentials from the Payme merchant cabinet). Leave empty until issued.
#PAYME_MERCHANT_ID=
#PAYME_KEY=
#PAYME_TEST_KEY=
PAYME_LOGIN=Paycom
PAYME_CHECKOUT_URL=https://checkout.paycom.uz
# Optional comma-separated allow-list of Payme callback source IPs (see docs/payments/payme-merchant-api.md)
#PAYME_ALLOWED_IPS=

# Click SHOP API / Merchant API credentials. Leave empty until issued.
#CLICK_SERVICE_ID=
#CLICK_MERCHANT_ID=
#CLICK_MERCHANT_USER_ID=
#CLICK_SECRET_KEY=
CLICK_API_URL=https://api.click.uz/v2/merchant
CLICK_PAY_URL=https://my.click.uz/services/pay
#CLICK_ALLOWED_IPS=
PAYMENT_EXPIRES_HOURS=24

# Error tracking (optional). Personal data is scrubbed before sending; see src/instrument.ts
#SENTRY_DSN=
#SENTRY_ENVIRONMENT=production
SENTRY_TRACES_SAMPLE_RATE=0
#SENTRY_RELEASE=

# S3-compatible object storage for uploads (optional until configured)
#S3_ENDPOINT=https://s3.example.uz
S3_REGION=us-east-1
#S3_BUCKET=ilmora-media
# Private documents (company and student certificates): its own bucket WITHOUT public read; CORS allows PUT from the site.
#S3_DOCS_BUCKET=ilmora-docs
#S3_ACCESS_KEY_ID=
#S3_SECRET_ACCESS_KEY=
#S3_PUBLIC_BASE_URL=https://media.ilmora.uz
S3_FORCE_PATH_STYLE=true

# First platform admin: this phone gets PLATFORM_ADMIN on first login/seed
# Super Admin is never configured through env: run `npm run owner:setup -- --login <login>` (README; --add for a second owner).
# Demo seed only (never in production): give the demo accounts this password for login + password sign-in.
#SEED_DEMO_PASSWORD=
# Seed: false skips the sample catalog (centers, teachers, courses, groups, videos, playlists, resources) for a real
# launch; tenant, site template, packages and categories are still created. Default true.
#SEED_CATALOG=true
# Password sign-in lockout per login (optional): LOGIN_MAX_FAILURES=10, LOGIN_LOCK_SECONDS=900
WORKER_CONCURRENCY=5
RATE_LIMIT_DEFAULT_PER_MINUTE=240
RATE_LIMIT_AUTH_PER_MINUTE=6

# Google OAuth (leave empty to run with password auth; when unconfigured, the UI clearly notifies user)
#GOOGLE_CLIENT_ID=your-client-id.apps.googleusercontent.com
#GOOGLE_CLIENT_SECRET=your-client-secret
# Required authorized redirect URI in Google Cloud Console:
# Development: http://localhost:3000/auth/google/callback
# Production:  https://ilmora.uz/auth/google/callback
#GOOGLE_CALLBACK_URL=http://localhost:3000/auth/google/callback

