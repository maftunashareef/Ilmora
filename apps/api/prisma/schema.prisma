// ILMORA production schema (PostgreSQL, Prisma 7).
//
// Conventions
// - Every business row carries `tenantId`; services always scope queries by it (see TenantScope in src/infra/prisma).
// - Soft-deletable entities carry `deletedAt`; the Prisma extension excludes them from normal queries.
// - Money: integer amounts in the smallest unit (tiyin) + explicit ISO currency. Never floats.
// - Timestamps are `timestamp(3)` columns holding UTC instants (Prisma reads and writes them as UTC); local scheduling uses Asia/Tashkent in application code.
// - Financial and attendance history is append-only: corrections and reversals create new rows, they never rewrite settled ones.

generator client {
  provider     = "prisma-client"
  output       = "../src/generated/prisma"
  moduleFormat = "cjs"
  runtime      = "nodejs"
}

datasource db {
  provider = "postgresql"
}

// ───────────────────────────── Enums ─────────────────────────────

enum Role {
  PLATFORM_ADMIN
  FINANCE_ADMIN
  CENTER_ADMIN
  TEACHER
  STUDENT
  /** Representative of a registry institution (User.institutionId). */
  INSTITUTION_ADMIN
  /** Representative of a registry company (User.companyId). */
  COMPANY_ADMIN
  /** Ministry staff: reviews institutions, sees the numbers. Granted only by the Super Admin, never at registration. */
  MINISTRY
}

enum Lang {
  uz
  ru
  en
}

enum ContentStatus {
  DRAFT
  PUBLISHED
  ARCHIVED
}

enum Visibility {
  PUBLIC
  PRIVATE
}

enum Level {
  BEGINNER
  INTERMEDIATE
  ADVANCED
}

/** How a course is taken: in person with seats and a schedule (OFFLINE), or on the provider's own site (ONLINE). */
enum LearningFormat {
  OFFLINE
  ONLINE
}

/**
 * Whether finishing an online course earns a certificate. AVAILABLE: the provider offers one but its course page does
 * not say whether it is free, so we do not claim either.
 */
enum CertificateKind {
  NONE
  FREE
  PAID
  AVAILABLE
}

enum SubscriptionStatus {
  DRAFT
  PENDING_PAYMENT
  ACTIVE
  /// Blocked: the period ended or the lessons are used up; seats are kept until graceEndsAt, a payment reactivates
  PAST_DUE
  CANCELLED
  /// Blocked and the grace period passed: seats released, a new checkout is needed
  EXPIRED
}

/// What a payment buys: a period of days (PERIOD) or a number of attended lessons (LESSONS).
enum SubscriptionKind {
  PERIOD
  LESSONS
}

/// Self-registered centers wait for the Super Admin's approval; blocked centers are hidden and their workspace is locked.
enum CenterStatus {
  PENDING
  ACTIVE
  BLOCKED
  REJECTED
}

enum EnrollmentStatus {
  /// Seat held while the first payment is pending (counts against capacity until the payment expires)
  PENDING
  ACTIVE
  CANCELLED
  COMPLETED
}

enum SessionStatus {
  SCHEDULED
  COMPLETED
  CANCELLED
}

enum AttendanceStatus {
  PRESENT
  ABSENT
  EXCUSED
}

enum AttendanceMethod {
  QR
  /// Scan of the center's standing QR code, validated against the lesson window (and the center's location when set)
  CENTER_QR
  MANUAL
  /// Absence recorded by the worker when the check-in window closed without a check-in
  AUTO
}

enum PaymentProvider {
  PAYME
  CLICK
  MANUAL
}

enum PaymentState {
  PENDING
  PAID
  CANCELLED
  EXPIRED
  REFUNDED
}

enum TransactionState {
  CREATED
  PERFORMED
  CANCELLED
  FAILED
}

enum LedgerDirection {
  DEBIT
  CREDIT
}

enum LedgerAccountType {
  PROVIDER_CLEARING
  SUBSCRIPTION_REVENUE
  CENTER_PAYABLE
  STUDENT_CREDIT
  REFUNDS
  ADJUSTMENTS
}

enum JournalKind {
  PAYMENT_SETTLED
  PAYMENT_CANCELLED
  PAYMENT_REFUNDED
  MANUAL_ADJUSTMENT
  REVERSAL
}

enum OtpPurpose {
  LOGIN
  PHONE_CHANGE
}

enum VideoSourceKind {
  LINK
  UPLOAD
}

enum ResourceKind {
  PDF
  DOC
  SHEET
  LINK
  OTHER
}

enum JobRunStatus {
  RUNNING
  SUCCEEDED
  FAILED
}

enum SmsStatus {
  QUEUED
  SENT
  FAILED
}

// ───────────────────────────── Tenancy & identity ─────────────────────────────

model Tenant {
  id          String    @id @default(cuid())
  slug        String    @unique
  name        String
  defaultLang Lang      @default(uz)
  /** Public web origin used in links (attendance URLs, receipts), e.g. https://ilmora.uz */
  webOrigin   String
  /** Deprecated: replaced by User.isOwner (several owners). Kept one release so a rollback still works; not read or written; drop later. */
  ownerUserId String?   @unique
  owner       User?     @relation("TenantOwner", fields: [ownerUserId], references: [id])
  createdAt   DateTime  @default(now())
  updatedAt   DateTime  @updatedAt
  deletedAt   DateTime?

  siteConfig      SiteConfig?
  users           User[]
  centers         Center[]
  categories      Category[]
  teachers        TeacherProfile[]
  subjects        Subject[]
  courses         Course[]
  groups          Group[]
  videos          Video[]
  playlists       Playlist[]
  resources       Resource[]
  packages        Package[]
  subscriptions   Subscription[]
  enrollments     Enrollment[]
  sessions        LessonSession[]
  attendance      AttendanceRecord[]
  payments        Payment[]
  transactions    PaymentTransaction[]
  journals        LedgerJournal[]
  ledgerEntries   LedgerEntry[]
  outbox          OutboxEvent[]
  auditEvents     AuditEvent[]
  otpCodes        OtpCode[]
  refreshSessions RefreshSession[]
  smsMessages     SmsMessage[]
  receipts        Receipt[]
  inquiries       CenterInquiry[]
  savedItems      SavedItem[]
  callbackLogs    ProviderCallbackLog[]
  notifications   Notification[]
  teacherInvites  TeacherInvite[]

  industries             Industry[]
  regions                Region[]
  districts              District[]
  directions             Direction[]
  institutions           Institution[]
  institutionDirections  InstitutionDirection[]
  companies              Company[]
  studentProfiles        StudentProfile[]
  studentConsents        StudentConsent[]
  studentCertificates    StudentCertificate[]
  announcements          GraduationAnnouncement[]
  announcementResponses  AnnouncementResponse[]
  trainingRequests       TrainingRequest[]
  trainingOffers         TrainingOffer[]
  contractHelpRequests   ContractHelpRequest[]
  contactRequests        ContactRequest[]
  vacancies              Vacancy[]
  vacancyApplications    VacancyApplication[]
  totpRecoveryCodes      TotpRecoveryCode[]
}

/// Template-driven site configuration (sections, theme, nav, features, permissions, media…) edited by Super Admin.
/// Stored as validated JSON (zod schema in src/modules/site); packages live in their own table for referential integrity.
model SiteConfig {
  tenantId    String   @id
  tenant      Tenant   @relation(fields: [tenantId], references: [id])
  data        Json
  version     Int      @default(1)
  updatedAt   DateTime @updatedAt
  updatedById String?
}

model User {
  id              String    @id @default(cuid())
  tenantId        String
  tenant          Tenant    @relation(fields: [tenantId], references: [id])
  /** Normalized E.164 phone (+998XXXXXXXXX), optional; unique per tenant when present. */
  phoneE164       String?
  phoneVerifiedAt DateTime?
  /** Sign-in name chosen at registration (normalized to lower case); unique per tenant. */
  login           String?
  /** argon2id hash. Null for accounts that have only ever signed in with a one-time code. */
  passwordHash    String?
  /** Google account id (ID token "sub"); the only key Google Sign-In may match an account by. Unique per tenant. */
  googleId        String?
  displayName     String
  district        String?
  preferredLang   Lang      @default(uz)
  reminders       Boolean   @default(true)
  roles           Role[]    @default([STUDENT])
  /** Center-scoped admins/teachers belong to one center; platform roles leave it null. */
  centerId        String?
  center          Center?   @relation(fields: [centerId], references: [id])
  isActive        Boolean   @default(true)
  /** Super Admin (owner). Set only by the owner-setup command on the server; a tenant may have several owners. */
  isOwner         Boolean   @default(false)
  /** Contact e-mail (registry: students, institution and company representatives). Not used for sign-in. */
  email           String?
  /** Position of an institution or company representative. */
  jobTitle        String?
  /** Registry representative: one account represents one institution or one company, and each has one representative. */
  institutionId   String?   @unique
  institution     Institution? @relation(fields: [institutionId], references: [id])
  companyId       String?   @unique
  company         Company?  @relation(fields: [companyId], references: [id])
  /** Second factor (TOTP, RFC 6238) for ministry staff and ILMORA moderators: the secret encrypted by the API, never plain. */
  totpSecretEnc   String?
  totpEnabledAt   DateTime?
  lastLoginAt     DateTime?
  /** Acceptance of the public offer (edition in offerVersion) and personal-data consent; see shared/legal. */
  offerAcceptedAt DateTime?
  offerVersion    String?
  consentAt       DateTime?
  consentAbroad   Boolean   @default(false)
  marketingAt     DateTime?
  createdAt       DateTime  @default(now())
  updatedAt       DateTime  @updatedAt
  deletedAt       DateTime?

  teacherProfile  TeacherProfile?
  subscriptions   Subscription[]
  enrollments     Enrollment[]
  attendance      AttendanceRecord[]  @relation("AttendanceStudent")
  recordedAttend  AttendanceRecord[]  @relation("AttendanceRecordedBy")
  payments        Payment[]
  refreshSessions RefreshSession[]
  savedItems      SavedItem[]
  auditEvents     AuditEvent[]
  ownedTenant     Tenant?   @relation("TenantOwner")
  notifications   Notification[]
  centerInvites   TeacherInvite[]
  totpRecoveryCodes      TotpRecoveryCode[]
  studentProfile         StudentProfile?
  studentConsents        StudentConsent[]
  studentCertificates    StudentCertificate[]
  announcementExclusions AnnouncementExclusion[]
  contractHelpRequests   ContractHelpRequest[]
  contactRequests        ContactRequest[]
  vacancyApplications    VacancyApplication[]

  @@unique([tenantId, phoneE164])
  @@unique([tenantId, login])
  @@unique([tenantId, googleId])
  @@index([tenantId, createdAt])
  @@index([tenantId, centerId])
}

model RefreshSession {
  id           String    @id @default(cuid())
  tenantId     String
  tenant       Tenant    @relation(fields: [tenantId], references: [id])
  userId       String
  user         User      @relation(fields: [userId], references: [id], onDelete: Cascade)
  /** All rotations of one login share a family; reuse of a rotated token revokes the whole family. */
  familyId     String
  /** SHA-256 of the opaque refresh token; the raw token exists only in the HTTP-only cookie. */
  tokenHash    String    @unique
  createdAt    DateTime  @default(now())
  expiresAt    DateTime
  rotatedAt    DateTime?
  revokedAt    DateTime?
  revokedReason String?
  replacedById String?
  ip           String?
  userAgent    String?

  @@index([userId, familyId])
  @@index([tenantId, expiresAt])
}

model OtpCode {
  id         String     @id @default(cuid())
  tenantId   String
  tenant     Tenant     @relation(fields: [tenantId], references: [id])
  phoneE164  String
  purpose    OtpPurpose @default(LOGIN)
  /** argon2 hash of the 6-digit code; the plain code is only ever sent by SMS. */
  codeHash   String
  attempts   Int        @default(0)
  maxAttempts Int       @default(5)
  expiresAt  DateTime
  consumedAt DateTime?
  createdAt  DateTime   @default(now())
  ip         String?

  @@index([tenantId, phoneE164, createdAt])
  @@index([expiresAt])
}

// ───────────────────────────── Catalog ─────────────────────────────

model Center {
  id          String    @id @default(cuid())
  tenantId    String
  tenant      Tenant    @relation(fields: [tenantId], references: [id])
  slug        String
  name        String
  district    Json
  description Json
  tone        String    @default("#163C35")
  address     String?
  phoneE164   String?
  status      CenterStatus @default(ACTIVE)
  /** Account that registered the center (its first administrator); null for centers created by the Super Admin. */
  ownerUserId String?
  approvedAt  DateTime?
  blockedAt   DateTime?
  blockReason String?
  /** A new name asked for after approval: the public name changes only when the Super Admin approves it. */
  pendingName   String?
  pendingNameAt DateTime?
  /** Opaque code inside the center's standing QR code (/attend/c/<code>); rotating it voids printed codes. */
  checkInCode          String?   @unique
  checkInCodeRotatedAt DateTime?
  /** Location of the center and the radius (metres) a check-in must come from; null = no location check. */
  lat         Float?
  lng         Float?
  geoRadiusM  Int?
  /** Check-in opens this many minutes before a lesson starts and closes this many minutes after it; absences are marked when it closes. */
  checkInBeforeMin Int  @default(15)
  absenceAfterMin  Int  @default(20)
  createdAt   DateTime  @default(now())
  updatedAt   DateTime  @updatedAt
  deletedAt   DateTime?

  staff    User[]
  teachers TeacherProfile[]
  courses  Course[]
  teacherInvites TeacherInvite[]
  /** The registry record of this learning center, when the Super Admin has linked one. */
  registryInstitution Institution?

  @@unique([tenantId, slug])
  @@index([tenantId, deletedAt])
  @@index([tenantId, status])
}

model Category {
  id        String    @id @default(cuid())
  tenantId  String
  tenant    Tenant    @relation(fields: [tenantId], references: [id])
  slug      String
  name      Json
  glyph     String    @default("")
  sortOrder Int       @default(0)
  createdAt DateTime  @default(now())
  updatedAt DateTime  @updatedAt
  deletedAt DateTime?

  courses Course[]

  @@unique([tenantId, slug])
}

model TeacherProfile {
  id            String    @id @default(cuid())
  tenantId      String
  tenant        Tenant    @relation(fields: [tenantId], references: [id])
  /** The login account behind the public profile (null until the teacher is invited). */
  userId        String?   @unique
  user          User?     @relation(fields: [userId], references: [id])
  slug          String
  name          String
  title         Json
  bio           Json
  expertise     String[]  @default([])
  /** Null for self-registered teachers until an admin assigns a center. */
  centerId      String?
  center        Center?   @relation(fields: [centerId], references: [id])
  avatarSeed    Int       @default(1)
  bannerTone    String    @default("#163C35")
  avatarUrl     String?
  bannerUrl     String?
  tagline       Json
  channelActive Boolean   @default(true)
  featuredType  String?
  featuredId    String?
  createdAt     DateTime  @default(now())
  updatedAt     DateTime  @updatedAt
  deletedAt     DateTime?

  subjects  Subject[]
  courses   Course[]
  videos    Video[]
  playlists Playlist[]
  resources Resource[]

  @@unique([tenantId, slug])
  @@index([tenantId, centerId])
}

model Subject {
  id          String         @id @default(cuid())
  tenantId    String
  tenant      Tenant         @relation(fields: [tenantId], references: [id])
  teacherId   String
  teacher     TeacherProfile @relation(fields: [teacherId], references: [id])
  name        Json
  description Json
  createdAt   DateTime       @default(now())
  updatedAt   DateTime       @updatedAt
  deletedAt   DateTime?

  courses Course[]

  @@index([tenantId, teacherId])
}

model Course {
  id               String         @id @default(cuid())
  tenantId         String
  tenant           Tenant         @relation(fields: [tenantId], references: [id])
  slug             String
  title            Json
  categoryId       String
  category         Category       @relation(fields: [categoryId], references: [id])
  centerId         String
  center           Center         @relation(fields: [centerId], references: [id])
  teacherId        String
  teacher          TeacherProfile @relation(fields: [teacherId], references: [id])
  subjectId        String?
  subject          Subject?       @relation(fields: [subjectId], references: [id])
  summary          Json
  description      Json
  curriculum       Json
  level            Level          @default(BEGINNER)
  durationMonths   Int            @default(3)
  /**
   * OFFLINE (default, every course before this field existed) runs in groups with seats and a schedule and is sold
   * through subscriptions. ONLINE is a free external course: the learner opens `externalUrl` on the provider's site,
   * there are no groups, and it never enters a cart or preset. ONLINE courses belong to the platform center/profile;
   * the real provider and instructor are kept as text so no profile is invented for a real person.
   */
  learningFormat   LearningFormat @default(OFFLINE)
  externalUrl      String?
  providerName     String?
  instructorName   String?
  certificate      CertificateKind @default(NONE)
  /** Human-readable length of an online course (localized), for example "about 9 weeks"; null when not stated. */
  durationText     Json?
  /** Monthly price in tiyin (1 so‘m = 100 tiyin). */
  priceMinor       BigInt
  /**
   * Optional discount window (one per course). All three are set together or all are null; the API enforces
   * percent 1..20 and endsAt > startsAt. Active when startsAt <= now < endsAt; see packages/shared/src/pricing.ts.
   */
  discountPercent  Int?
  discountStartsAt DateTime?
  discountEndsAt   DateTime?
  currency         String         @default("UZS")
  coverSeed        Int            @default(1)
  imageUrl         String?
  meyosGrant       Boolean        @default(false)
  status           ContentStatus  @default(DRAFT)
  visibility       Visibility     @default(PUBLIC)
  audienceStudentIds String[]     @default([])
  audienceGroupIds   String[]     @default([])
  featured         Boolean        @default(false)
  reviewRequested  Boolean        @default(false)
  publishedAt      DateTime?
  createdById      String?
  updatedById      String?
  createdAt        DateTime       @default(now())
  updatedAt        DateTime       @updatedAt
  deletedAt        DateTime?

  groups      Group[]
  enrollments Enrollment[]
  sessions    LessonSession[]
  videos      Video[]
  resources   Resource[]

  @@unique([tenantId, slug])
  @@index([tenantId, status, visibility, deletedAt])
  @@index([tenantId, learningFormat])
  @@index([tenantId, centerId])
  @@index([tenantId, teacherId])
  @@index([tenantId, categoryId])
}

model Group {
  id        String    @id @default(cuid())
  tenantId  String
  tenant    Tenant    @relation(fields: [tenantId], references: [id])
  courseId  String
  course    Course    @relation(fields: [courseId], references: [id])
  name      String
  /** Weekdays the group meets: 0 = Monday … 6 = Sunday */
  days      Int[]
  /** Local wall-clock times in the group's timezone, "HH:MM" */
  startTime String
  endTime   String
  room      String    @default("")
  /** Teacher-defined maximum of ACTIVE enrollments; enforced inside a row-locked transaction. */
  capacity  Int
  timezone  String    @default("Asia/Tashkent")
  createdAt DateTime  @default(now())
  updatedAt DateTime  @updatedAt
  deletedAt DateTime?

  enrollments Enrollment[]
  sessions    LessonSession[]

  @@index([tenantId, courseId])
}

model Package {
  id          String   @id @default(cuid())
  tenantId    String
  tenant      Tenant   @relation(fields: [tenantId], references: [id])
  code        String
  name        Json
  description Json
  perks       Json
  maxCourses  Int
  /** PERIOD: access for periodDays (null = one calendar month) per payment; LESSONS: lessonCount attended lessons per payment. */
  accessKind  SubscriptionKind @default(PERIOD)
  periodDays  Int?
  lessonCount Int?
  enabled     Boolean  @default(true)
  highlight   Boolean  @default(false)
  sortOrder   Int      @default(0)
  createdAt   DateTime @default(now())
  updatedAt   DateTime @updatedAt

  subscriptions Subscription[]

  @@unique([tenantId, code])
}

// ───────────────────────────── Teacher content ─────────────────────────────

model Video {
  id                 String          @id @default(cuid())
  tenantId           String
  tenant             Tenant          @relation(fields: [tenantId], references: [id])
  teacherId          String
  teacher            TeacherProfile  @relation(fields: [teacherId], references: [id])
  courseId           String?
  course             Course?         @relation(fields: [courseId], references: [id])
  title              Json
  description        Json
  sourceKind         VideoSourceKind @default(LINK)
  sourceUrl          String?
  storageKey         String?
  durationSec        Int             @default(0)
  thumbnailUrl       String?
  coverSeed          Int             @default(1)
  status             ContentStatus   @default(DRAFT)
  visibility         Visibility      @default(PUBLIC)
  audienceStudentIds String[]        @default([])
  audienceGroupIds   String[]        @default([])
  featured           Boolean         @default(false)
  reviewRequested    Boolean         @default(false)
  createdAt          DateTime        @default(now())
  updatedAt          DateTime        @updatedAt
  deletedAt          DateTime?

  playlistItems PlaylistItem[]

  @@index([tenantId, teacherId, status])
  @@index([tenantId, courseId])
}

model Playlist {
  id                 String         @id @default(cuid())
  tenantId           String
  tenant             Tenant         @relation(fields: [tenantId], references: [id])
  teacherId          String
  teacher            TeacherProfile @relation(fields: [teacherId], references: [id])
  title              Json
  description        Json
  coverSeed          Int            @default(1)
  status             ContentStatus  @default(DRAFT)
  visibility         Visibility     @default(PUBLIC)
  audienceStudentIds String[]       @default([])
  audienceGroupIds   String[]       @default([])
  featured           Boolean        @default(false)
  reviewRequested    Boolean        @default(false)
  createdAt          DateTime       @default(now())
  updatedAt          DateTime       @updatedAt
  deletedAt          DateTime?

  items PlaylistItem[]

  @@index([tenantId, teacherId, status])
}

model PlaylistItem {
  playlistId String
  playlist   Playlist @relation(fields: [playlistId], references: [id], onDelete: Cascade)
  videoId    String
  video      Video    @relation(fields: [videoId], references: [id], onDelete: Cascade)
  position   Int

  @@id([playlistId, videoId])
  @@index([playlistId, position])
}

model Resource {
  id                 String         @id @default(cuid())
  tenantId           String
  tenant             Tenant         @relation(fields: [tenantId], references: [id])
  teacherId          String
  teacher            TeacherProfile @relation(fields: [teacherId], references: [id])
  courseId           String?
  course             Course?        @relation(fields: [courseId], references: [id])
  title              Json
  description        Json
  kind               ResourceKind   @default(OTHER)
  fileName           String?
  fileSize           Int?
  fileMime           String?
  storageKey         String?
  url                String?
  pages              Int?
  status             ContentStatus  @default(DRAFT)
  visibility         Visibility     @default(PUBLIC)
  audienceStudentIds String[]       @default([])
  audienceGroupIds   String[]       @default([])
  featured           Boolean        @default(false)
  reviewRequested    Boolean        @default(false)
  createdAt          DateTime       @default(now())
  updatedAt          DateTime       @updatedAt
  deletedAt          DateTime?

  @@index([tenantId, teacherId, status])
  @@index([tenantId, courseId])
}

model SavedItem {
  id        String   @id @default(cuid())
  tenantId  String
  tenant    Tenant   @relation(fields: [tenantId], references: [id])
  userId    String
  user      User     @relation(fields: [userId], references: [id], onDelete: Cascade)
  /** "course" | "teacher" */
  kind      String
  itemId    String
  createdAt DateTime @default(now())

  @@unique([userId, kind, itemId])
}

// ───────────────────────────── Subscriptions & enrollment ─────────────────────────────

model Subscription {
  id             String             @id @default(cuid())
  tenantId       String
  tenant         Tenant             @relation(fields: [tenantId], references: [id])
  studentId      String
  student        User               @relation(fields: [studentId], references: [id])
  packageId      String?
  package        Package?           @relation(fields: [packageId], references: [id])
  status         SubscriptionStatus @default(DRAFT)
  /** Draft selection (builder) before activation; enrollments are created on activation. */
  draftGroupIds  String[]           @default([])
  meyosGrant     Boolean            @default(false)
  grantCourseIds String[]           @default([])
  /** Monthly total = sum of the selected courses' prices, snapshotted at activation. */
  amountMinor    BigInt             @default(0)
  currency       String             @default("UZS")
  /** Copied from the package at checkout; a custom selection is PERIOD. */
  kind           SubscriptionKind   @default(PERIOD)
  /** LESSONS kind: lessons bought for the current period and lessons already attended (PRESENT records, see AttendanceRecord.lessonCounted). */
  lessonsTotal   Int?
  lessonsUsed    Int                @default(0)
  /** PAST_DUE keeps the seats until graceEndsAt; then EXPIRED releases them. */
  graceEndsAt    DateTime?
  blockedAt      DateTime?
  blockReason    String?
  /** When the "ending soon" reminder for the current period was sent (cleared on renewal). */
  expiryReminderAt DateTime?
  startedAt      DateTime?
  currentPeriodStart DateTime?
  currentPeriodEnd   DateTime?
  cancelledAt    DateTime?
  createdAt      DateTime           @default(now())
  updatedAt      DateTime           @updatedAt

  enrollments Enrollment[]
  payments    Payment[]

  @@index([tenantId, studentId, status])
  @@index([tenantId, status, currentPeriodEnd])
  @@index([tenantId, status, graceEndsAt])
}

model Enrollment {
  id             String           @id @default(cuid())
  tenantId       String
  tenant         Tenant           @relation(fields: [tenantId], references: [id])
  subscriptionId String
  subscription   Subscription     @relation(fields: [subscriptionId], references: [id])
  studentId      String
  student        User             @relation(fields: [studentId], references: [id])
  groupId        String
  group          Group            @relation(fields: [groupId], references: [id])
  courseId       String
  course         Course           @relation(fields: [courseId], references: [id])
  status         EnrollmentStatus @default(ACTIVE)
  enrolledAt     DateTime         @default(now())
  cancelledAt    DateTime?
  createdAt      DateTime         @default(now())
  updatedAt      DateTime         @updatedAt

  @@unique([subscriptionId, groupId])
  @@index([tenantId, groupId, status])
  @@index([tenantId, studentId, status])
}

// ───────────────────────────── Lessons & attendance ─────────────────────────────

model LessonSession {
  id                       String        @id @default(cuid())
  tenantId                 String
  tenant                   Tenant        @relation(fields: [tenantId], references: [id])
  groupId                  String
  group                    Group         @relation(fields: [groupId], references: [id])
  courseId                 String
  course                   Course        @relation(fields: [courseId], references: [id])
  /** Calendar date of the lesson in the group's timezone (YYYY-MM-DD, stored as DATE). */
  date                     DateTime      @db.Date
  startsAt                 DateTime
  endsAt                   DateTime
  status                   SessionStatus @default(SCHEDULED)
  attendanceOpen           Boolean       @default(false)
  attendanceOpenedAt       DateTime?
  attendanceClosedAt       DateTime?
  /** SHA-256 of the current attendance token; rotated on every open; null while closed. */
  attendanceTokenHash      String?
  attendanceTokenExpiresAt DateTime?
  tokenVersion             Int           @default(0)
  generatedBy              String?
  cancelledAt              DateTime?
  cancelledById            String?
  /** Exceptions to the weekly pattern: a one-off lesson, or a lesson moved from another date (the original is cancelled and points here). */
  isExtra                  Boolean       @default(false)
  rescheduledFromId        String?
  note                     String?
  /** Set by the worker once absences were recorded for this lesson (null = not processed yet). */
  absenceMarkedAt          DateTime?
  createdAt                DateTime      @default(now())
  updatedAt                DateTime      @updatedAt

  attendance AttendanceRecord[]

  @@unique([groupId, date])
  @@index([tenantId, date])
  @@index([tenantId, groupId, startsAt])
  @@index([tenantId, status, startsAt])
  @@index([tenantId, absenceMarkedAt, startsAt])
}

model AttendanceRecord {
  id             String           @id @default(cuid())
  tenantId       String
  tenant         Tenant           @relation(fields: [tenantId], references: [id])
  sessionId      String
  session        LessonSession    @relation(fields: [sessionId], references: [id])
  studentId      String
  student        User             @relation("AttendanceStudent", fields: [studentId], references: [id])
  status         AttendanceStatus @default(PRESENT)
  method         AttendanceMethod @default(QR)
  /** First successful check-in instant (for AUTO absences: when the absence was recorded); never overwritten by repeated scans. */
  checkedInAt    DateTime
  /** Null for records written by the worker (AUTO absences). */
  recordedById   String?
  recordedBy     User?            @relation("AttendanceRecordedBy", fields: [recordedById], references: [id])
  /** Required for MANUAL records and corrections. */
  reason         String?
  /** True while this PRESENT record counts as one used lesson of a LESSONS subscription (given back on correction). */
  lessonCounted  Boolean          @default(false)
  correctedAt    DateTime?
  correctedById  String?
  tokenVersion   Int?
  ip             String?
  userAgent      String?
  version        Int              @default(1)
  createdAt      DateTime         @default(now())
  updatedAt      DateTime         @updatedAt

  @@unique([sessionId, studentId])
  @@index([tenantId, studentId, checkedInAt])
  @@index([tenantId, sessionId])
}

// ───────────────────────────── Payments & ledger ─────────────────────────────

/// What is being paid: one subscription period. Providers attach transactions to it.
model Payment {
  id             String          @id @default(cuid())
  tenantId       String
  tenant         Tenant          @relation(fields: [tenantId], references: [id])
  studentId      String
  student        User            @relation(fields: [studentId], references: [id])
  subscriptionId String
  subscription   Subscription    @relation(fields: [subscriptionId], references: [id])
  periodStart    DateTime
  periodEnd      DateTime
  amountMinor    BigInt
  currency       String          @default("UZS")
  state          PaymentState    @default(PENDING)
  provider       PaymentProvider?
  paidAt         DateTime?
  cancelledAt    DateTime?
  refundedAt     DateTime?
  expiresAt      DateTime
  createdById    String?
  createdAt      DateTime        @default(now())
  updatedAt      DateTime        @updatedAt

  transactions PaymentTransaction[]
  receipt      Receipt?

  @@index([tenantId, studentId, state])
  @@index([tenantId, state, createdAt])
  @@index([tenantId, subscriptionId])
}

model PaymentTransaction {
  id                    String           @id @default(cuid())
  /** Numeric id exposed to providers that require integers (Click merchant_prepare_id / merchant_confirm_id, Payme `transaction`). */
  seq                   Int              @unique @default(autoincrement())
  /** True when the callback was authenticated with the provider's sandbox/test key. */
  sandbox               Boolean          @default(false)
  tenantId              String
  tenant                Tenant           @relation(fields: [tenantId], references: [id])
  paymentId             String
  payment               Payment          @relation(fields: [paymentId], references: [id])
  provider              PaymentProvider
  /** Provider's own transaction id (Payme `id`, Click `click_trans_id`). Unique per provider. */
  providerTransactionId String
  /** Provider-side timestamp for the creation (Payme `time`, Click `sign_time`). */
  providerTime          BigInt?
  providerState         Int?
  state                 TransactionState @default(CREATED)
  amountMinor           BigInt
  currency              String           @default("UZS")
  createdAt             DateTime         @default(now())
  performedAt           DateTime?
  cancelledAt           DateTime?
  cancelReason          Int?
  /** Click prepare step id returned to Click; null for Payme. */
  merchantPrepareId     String?
  updatedAt             DateTime         @updatedAt

  @@unique([provider, providerTransactionId])
  @@index([tenantId, paymentId])
  @@index([tenantId, provider, createdAt])
  @@index([tenantId, state])
}

/// Every inbound provider callback, redacted, for replay analysis and reconciliation.
model ProviderCallbackLog {
  id                    String          @id @default(cuid())
  tenantId              String?
  tenant                Tenant?         @relation(fields: [tenantId], references: [id])
  provider              PaymentProvider
  method                String
  providerTransactionId String?
  paymentId             String?
  payload               Json
  responseCode          Int?
  outcome               String?
  ip                    String?
  receivedAt            DateTime        @default(now())
  processedAt           DateTime?
  durationMs            Int?

  @@index([provider, receivedAt])
  @@index([providerTransactionId])
}

model LedgerJournal {
  id            String       @id @default(cuid())
  tenantId      String
  tenant        Tenant       @relation(fields: [tenantId], references: [id])
  kind          JournalKind
  referenceType String
  referenceId   String
  description   String
  /** A reversal journal points at the journal it reverses; settled journals are never edited. */
  reversalOfId  String?      @unique
  reversalOf    LedgerJournal? @relation("JournalReversal", fields: [reversalOfId], references: [id])
  reversedBy    LedgerJournal? @relation("JournalReversal")
  createdById   String?
  reason        String?
  createdAt     DateTime     @default(now())

  entries LedgerEntry[]

  @@unique([tenantId, kind, referenceType, referenceId])
  @@index([tenantId, createdAt])
}

model LedgerEntry {
  id          String            @id @default(cuid())
  tenantId    String
  tenant      Tenant            @relation(fields: [tenantId], references: [id])
  journalId   String
  journal     LedgerJournal     @relation(fields: [journalId], references: [id])
  account     String
  accountType LedgerAccountType
  direction   LedgerDirection
  amountMinor BigInt
  currency    String            @default("UZS")
  createdAt   DateTime          @default(now())

  @@index([tenantId, account, createdAt])
  @@index([journalId])
}

model Receipt {
  id          String   @id @default(cuid())
  tenantId    String
  tenant      Tenant   @relation(fields: [tenantId], references: [id])
  paymentId   String   @unique
  payment     Payment  @relation(fields: [paymentId], references: [id])
  number      String
  issuedAt    DateTime @default(now())
  deliveredAt DateTime?
  channel     String?

  @@unique([tenantId, number])
}

/// Transactional outbox: durable notification/side-effect intents written in the same DB transaction as the state change.
model OutboxEvent {
  id          String    @id @default(cuid())
  tenantId    String?
  tenant      Tenant?   @relation(fields: [tenantId], references: [id])
  type        String
  dedupeKey   String?   @unique
  payload     Json
  availableAt DateTime  @default(now())
  attempts    Int       @default(0)
  lastError   String?
  lockedAt    DateTime?
  processedAt DateTime?
  createdAt   DateTime  @default(now())

  @@index([processedAt, availableAt])
}

// ───────────────────────────── Audit, jobs, messaging ─────────────────────────────

model AuditEvent {
  id         String   @id @default(cuid())
  tenantId   String
  tenant     Tenant   @relation(fields: [tenantId], references: [id])
  actorId    String?
  actor      User?    @relation(fields: [actorId], references: [id])
  actorRoles Role[]   @default([])
  action     String
  entityType String
  entityId   String
  before     Json?
  after      Json?
  reason     String?
  ip         String?
  userAgent  String?
  requestId  String?
  createdAt  DateTime @default(now())

  @@index([tenantId, entityType, entityId, createdAt])
  @@index([tenantId, createdAt])
  @@index([tenantId, actorId, createdAt])
}

/// Idempotency marker for scheduled jobs: one row per (queue, jobKey); a second worker finds the row and skips.
model JobRun {
  id         String       @id @default(cuid())
  queue      String
  jobKey     String
  status     JobRunStatus @default(RUNNING)
  workerId   String?
  startedAt  DateTime     @default(now())
  finishedAt DateTime?
  result     Json?
  error      String?

  @@unique([queue, jobKey])
  @@index([queue, startedAt])
}

model SmsMessage {
  id                String    @id @default(cuid())
  tenantId          String
  tenant            Tenant    @relation(fields: [tenantId], references: [id])
  phoneE164         String
  templateKey       String
  lang              Lang      @default(uz)
  status            SmsStatus @default(QUEUED)
  providerMessageId String?
  attempts          Int       @default(0)
  error             String?
  createdAt         DateTime  @default(now())
  sentAt            DateTime?

  @@index([tenantId, createdAt])
  @@index([status, createdAt])
}

/// In-app notification. `type` selects the dictionary text (`notif.<type>`), `params` fills its placeholders in the reader's language.
model Notification {
  id        String    @id @default(cuid())
  tenantId  String
  tenant    Tenant    @relation(fields: [tenantId], references: [id])
  userId    String
  user      User      @relation(fields: [userId], references: [id], onDelete: Cascade)
  type      String
  params    Json
  /** Stops the same event from producing two rows (e.g. one reminder per subscription period). */
  dedupeKey String?   @unique
  readAt    DateTime?
  createdAt DateTime  @default(now())

  @@index([tenantId, userId, readAt, createdAt])
  @@index([userId, createdAt])
}

enum TeacherInviteStatus {
  PENDING
  ACCEPTED
  DECLINED
}

/// A center's invitation to a registered teacher: the teacher joins the center only after accepting it.
model TeacherInvite {
  id          String              @id @default(cuid())
  tenantId    String
  tenant      Tenant              @relation(fields: [tenantId], references: [id])
  centerId    String
  center      Center              @relation(fields: [centerId], references: [id], onDelete: Cascade)
  userId      String
  user        User                @relation(fields: [userId], references: [id], onDelete: Cascade)
  status      TeacherInviteStatus @default(PENDING)
  invitedById String?
  createdAt   DateTime            @default(now())
  respondedAt DateTime?

  @@unique([centerId, userId])
  @@index([tenantId, userId, status])
}

model CenterInquiry {
  id          String    @id @default(cuid())
  tenantId    String
  tenant      Tenant    @relation(fields: [tenantId], references: [id])
  centerName  String
  contactName String
  phoneE164   String
  message     String
  consentAt   DateTime
  handledAt   DateTime?
  createdAt   DateTime  @default(now())

  @@index([tenantId, createdAt])
}

// ───────────────────────────── Registry: institutions, companies, students ─────────────────────────────
//
// The ministry registry (TZ «ILMORA — реестр учреждений, компании, студенты», 9 Nov 2026). It sits beside the
// learning-center marketplace above and changes nothing in it. What ties institutions, companies and students together
// is the direction (Direction) with its required industry (Industry): matching and the ministry's numbers go by industry
// through the direction, so moving a direction to another industry moves everything that points at it.
// Duplicates are stopped by unique indexes, not only by code: one direction per normalized name, one institution and
// one company per STIR, one representative per institution or company (User.institutionId / User.companyId).
// Child rows without `tenantId` (CompanyIndustry, AnnouncementLine, …) are reached only through their parent.

enum InstitutionType {
  TECHNIKUM
  COLLEGE
  LYCEUM
  SCHOOL
  UNIVERSITY
  TRAINING_CENTER
}

enum Ownership {
  STATE
  PRIVATE
}

/// Where a registry record came from: the ministry's Excel, the institution itself, or a student who did not find it.
enum InstitutionSource {
  IMPORT
  SELF
  STUDENT
}

/// UNCLAIMED: in the registry (import or added by a student) with nobody representing it yet.
enum InstitutionStatus {
  UNCLAIMED
  DRAFT
  PENDING
  APPROVED
  REJECTED
}

enum CompanyStatus {
  DRAFT
  PENDING
  APPROVED
  REJECTED
}

/// OFFICIAL: from the ministry's classifier; USER: typed by an institution, student or company; ADMIN: added by the Super Admin.
enum DirectionOrigin {
  OFFICIAL
  USER
  ADMIN
}

enum StudentMode {
  STUDYING
  APPLYING
}

enum StudyForm {
  GRANT
  CONTRACT
  UNDECIDED
}

enum StudyConfirmation {
  NONE
  PENDING
  CONFIRMED
  REJECTED
}

/// GRADUATE_CARD: show my card in my institution's graduation announcements. CONTRACT_HELP_CARD: send my anonymised
/// card to companies. COMPANY_CONTACTS: open my contacts to one company (StudentConsent.companyId). PARENT_CONSENT:
/// the parent or legal representative of a minor agreed.
enum ConsentKind {
  GRADUATE_CARD
  CONTRACT_HELP_CARD
  COMPANY_CONTACTS
  PARENT_CONSENT
}

enum AnnouncementStatus {
  DRAFT
  PUBLISHED
  CLOSED
}

/// Answer to a response, an offer or a contact request.
enum MatchStatus {
  PENDING
  ACCEPTED
  DECLINED
  WITHDRAWN
}

enum TrainingRequestStatus {
  OPEN
  CLOSED
}

enum ContractHelpStatus {
  ACTIVE
  INTERESTED
  SIGNED
  WITHDRAWN
}

enum ContactSource {
  GRADUATE
  CONTRACT_HELP
}

enum VacancyKind {
  PRACTICE
  INTERNSHIP
}

enum WorkFormat {
  ONSITE
  REMOTE
  HYBRID
}

enum VacancyStatus {
  OPEN
  CLOSED
}

enum ApplicationStatus {
  NEW
  VIEWED
  INVITED
  REJECTED
}

/// One-time recovery code for the TOTP second factor (10 per enrolment); only the hash is stored.
model TotpRecoveryCode {
  id        String    @id @default(cuid())
  tenantId  String
  tenant    Tenant    @relation(fields: [tenantId], references: [id])
  userId    String
  user      User      @relation(fields: [userId], references: [id], onDelete: Cascade)
  codeHash  String
  usedAt    DateTime?
  createdAt DateTime  @default(now())

  @@index([userId, usedAt])
}

/// Industry (отрасль): a short fixed list edited by the Super Admin; every direction belongs to one.
model Industry {
  id        String   @id @default(cuid())
  tenantId  String
  tenant    Tenant   @relation(fields: [tenantId], references: [id])
  slug      String
  /** { uz, ru, en } */
  name      Json
  sortOrder Int      @default(0)
  isActive  Boolean  @default(true)
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  directions Direction[]
  companies  CompanyIndustry[]

  @@unique([tenantId, slug])
  @@index([tenantId, sortOrder])
}

/// Region: 12 regions, the Republic of Karakalpakstan and Tashkent city. `code` is the official SOATO code; `slug` is the
/// id the web app uses for the region (UZ_REGIONS in @ilmora/shared, e.g. "andijan").
model Region {
  id        String   @id @default(cuid())
  tenantId  String
  tenant    Tenant   @relation(fields: [tenantId], references: [id])
  code      String
  slug      String?
  /** { uz, ru, en } */
  name      Json
  sortOrder Int      @default(0)

  districts        District[]
  institutions     Institution[]
  companies        Company[]
  students         StudentProfile[]
  trainingRequests TrainingRequest[]
  vacancies        Vacancy[]
  contractHelpWork ContractHelpRequest[]

  @@unique([tenantId, code])
  @@unique([tenantId, slug])
}

/// District (туман/шаҳар) of a region. Only official SOATO codes, never invented ones.
model District {
  id       String @id @default(cuid())
  tenantId String
  tenant   Tenant @relation(fields: [tenantId], references: [id])
  regionId String
  region   Region @relation(fields: [regionId], references: [id])
  code     String
  /** { uz, ru, en } */
  name     Json

  institutions Institution[]
  companies    Company[]
  students     StudentProfile[]
  vacancies    Vacancy[]

  @@unique([tenantId, code])
  @@index([regionId])
}

/// Direction (направление): one shared list that grows as people type. `searchKey` is the normalized name
/// (`registrySearchKey` in @ilmora/shared: lower case, Uzbek Cyrillic → Latin, ILMORA letters and apostrophes folded, no punctuation) and is
/// unique, so the same name typed twice finds the existing row. A merged duplicate keeps its row and key as an alias
/// pointing at the main direction (`mergedIntoId`); all references move to the main one, and a search that hits the
/// alias returns the main direction.
model Direction {
  id           String          @id @default(cuid())
  tenantId     String
  tenant       Tenant          @relation(fields: [tenantId], references: [id])
  name         String
  searchKey    String
  industryId   String
  industry     Industry        @relation(fields: [industryId], references: [id])
  origin       DirectionOrigin @default(USER)
  /** Code from the ministry's classifier, when there is one. */
  code         String?
  mergedIntoId String?
  mergedInto   Direction?      @relation("DirectionMerge", fields: [mergedIntoId], references: [id])
  aliases      Direction[]     @relation("DirectionMerge")
  createdById  String?
  createdAt    DateTime        @default(now())
  updatedAt    DateTime        @updatedAt

  institutionDirections InstitutionDirection[]
  students              StudentProfile[]
  companies             CompanyDirection[]
  announcementLines     AnnouncementLine[]
  trainingRequests      TrainingRequest[]
  vacancies             VacancyDirection[]

  @@unique([tenantId, searchKey])
  @@index([tenantId, industryId])
  @@index([tenantId, mergedIntoId])
}

/// An educational institution in the ministry registry. The cabinet opens once the ministry has approved it
/// (`approvedAt` is set); a later change of name, STIR, type, ownership or region sends it back to PENDING while the
/// cabinet keeps working. Required passport fields are checked when the representative submits, not by the database,
/// so a draft can be saved half-filled.
model Institution {
  id           String            @id @default(cuid())
  tenantId     String
  tenant       Tenant            @relation(fields: [tenantId], references: [id])
  type         InstitutionType
  ownership    Ownership?
  name         String
  /** Russian name and the name before the 2025 renaming (PF-190), from the official list; people search by both. */
  nameRu       String?
  formerName   String?
  /** Normalized name (`registrySearchKey`): exact matches, e.g. a student adding an institution that already exists. */
  searchKey    String
  /** Normalized name + Russian name + former name, for «contains» search. */
  searchText   String?
  /** Taxpayer number, 9 digits; unique when present (records added by students have none). */
  stir         String?
  /** Head organization of a branch, in case branches turn out to share the head's STIR (asked of the ministry). */
  parentId     String?
  parent       Institution?      @relation("InstitutionBranch", fields: [parentId], references: [id])
  branches     Institution[]     @relation("InstitutionBranch")
  regionId     String?
  region       Region?           @relation(fields: [regionId], references: [id])
  districtId   String?
  district     District?         @relation(fields: [districtId], references: [id])
  /** District as written in the official list, until the districts' SOATO codes are loaded (then districtId). */
  districtName String?
  address      String?
  phone        String?
  email        String?
  website      String?
  directorName String?
  status       InstitutionStatus @default(UNCLAIMED)
  source       InstitutionSource
  submittedAt  DateTime?
  approvedAt   DateTime?
  reviewedAt   DateTime?
  reviewedById String?
  rejectReason String?
  /** The learning center that already works in ILMORA, when the Super Admin links one. */
  centerId     String?           @unique
  center       Center?           @relation(fields: [centerId], references: [id])
  /** A student-added record merged by the Super Admin into the real one; references move to the target. */
  mergedIntoId String?
  mergedInto   Institution?      @relation("InstitutionMerge", fields: [mergedIntoId], references: [id])
  mergedFrom   Institution[]     @relation("InstitutionMerge")
  createdById  String?
  createdAt    DateTime          @default(now())
  updatedAt    DateTime          @updatedAt

  representative User?
  directions     InstitutionDirection[]
  students       StudentProfile[]
  announcements  GraduationAnnouncement[]
  trainingOffers TrainingOffer[]

  @@unique([tenantId, stir])
  @@index([tenantId, status])
  @@index([tenantId, regionId, districtId])
  @@index([tenantId, type, ownership])
  @@index([tenantId, searchKey])
}

/// A direction an institution teaches, with how many students are on it (the institution's own figure).
model InstitutionDirection {
  id            String      @id @default(cuid())
  tenantId      String
  tenant        Tenant      @relation(fields: [tenantId], references: [id])
  institutionId String
  institution   Institution @relation(fields: [institutionId], references: [id], onDelete: Cascade)
  directionId   String
  direction     Direction   @relation(fields: [directionId], references: [id])
  /** Department or faculty, optional. */
  department    String?
  studentsCount Int         @default(0)
  createdAt     DateTime    @default(now())
  updatedAt     DateTime    @updatedAt

  @@unique([institutionId, directionId])
  @@index([tenantId, directionId])
}

/// An employer, checked by ILMORA. Free for companies. The certificate file sits in the private documents bucket.
model Company {
  id                 String        @id @default(cuid())
  tenantId           String
  tenant             Tenant        @relation(fields: [tenantId], references: [id])
  /** Taxpayer number, 9 digits. */
  stir               String
  name               String
  /** Normalized name for search (`registrySearchKey`). */
  searchKey          String
  regionId           String?
  region             Region?       @relation(fields: [regionId], references: [id])
  districtId         String?
  district           District?     @relation(fields: [districtId], references: [id])
  address            String?
  website            String?
  about              String?
  /** Object key of the state-registration certificate in the private bucket (ilmora-docs); only moderators read it. */
  certificateFileKey String?
  status             CompanyStatus @default(DRAFT)
  submittedAt        DateTime?
  approvedAt         DateTime?
  reviewedAt         DateTime?
  reviewedById       String?
  rejectReason       String?
  createdAt          DateTime      @default(now())
  updatedAt          DateTime      @updatedAt

  representative        User?
  industries            CompanyIndustry[]
  directions            CompanyDirection[]
  announcementResponses AnnouncementResponse[]
  trainingRequests      TrainingRequest[]
  contactRequests       ContactRequest[]
  consents              StudentConsent[]
  vacancies             Vacancy[]
  signedContractHelp    ContractHelpRequest[]

  @@unique([tenantId, stir])
  @@index([tenantId, status])
  @@index([tenantId, regionId])
  @@index([tenantId, searchKey])
}

model CompanyIndustry {
  companyId  String
  company    Company  @relation(fields: [companyId], references: [id], onDelete: Cascade)
  industryId String
  industry   Industry @relation(fields: [industryId], references: [id])

  @@id([companyId, industryId])
  @@index([industryId])
}

model CompanyDirection {
  companyId   String
  company     Company   @relation(fields: [companyId], references: [id], onDelete: Cascade)
  directionId String
  direction   Direction @relation(fields: [directionId], references: [id])

  @@id([companyId, directionId])
  @@index([directionId])
}

/// The student's questionnaire («уже учусь» / «хочу поступить»). Name, phone and e-mail live on User; consents are in
/// StudentConsent. The institution confirms that the student studies there (studyConfirmation).
model StudentProfile {
  id                  String            @id @default(cuid())
  tenantId            String
  tenant              Tenant            @relation(fields: [tenantId], references: [id])
  userId              String            @unique
  user                User              @relation(fields: [userId], references: [id], onDelete: Cascade)
  mode                StudentMode
  institutionType     InstitutionType?
  /** Null while applying with «ещё не решил». */
  institutionId       String?
  institution         Institution?      @relation(fields: [institutionId], references: [id])
  /** Year of study 1–6; for a school, the class 1–11. */
  course              Int?
  enrollYear          Int?
  graduationYear      Int?
  directionId         String?
  direction           Direction?        @relation(fields: [directionId], references: [id])
  studyForm           StudyForm?
  /** Yearly contract amount the student entered, in tiyin. Informational: no contract money moves through ILMORA. */
  contractAmountMinor BigInt?
  birthDate           DateTime?         @db.Date
  regionId            String?
  region              Region?           @relation(fields: [regionId], references: [id])
  districtId          String?
  district            District?         @relation(fields: [districtId], references: [id])
  about               String?
  /** Parent or legal representative of a minor; their consent is a PARENT_CONSENT row in StudentConsent. */
  parentName          String?
  parentPhone         String?
  studyConfirmation   StudyConfirmation @default(NONE)
  studyConfirmedAt    DateTime?
  studyConfirmedById  String?
  createdAt           DateTime          @default(now())
  updatedAt           DateTime          @updatedAt

  @@index([tenantId, institutionId, studyConfirmation])
  @@index([tenantId, directionId, graduationYear])
  @@index([tenantId, mode])
  @@index([tenantId, regionId])
}

/// Consent journal: a row is never rewritten. Revoking sets `revokedAt`; giving the consent again adds a new row, so the
/// history of consents and revocations can always be shown. The current consent is the latest row without `revokedAt`.
model StudentConsent {
  id          String      @id @default(cuid())
  tenantId    String
  tenant      Tenant      @relation(fields: [tenantId], references: [id])
  userId      String
  user        User        @relation(fields: [userId], references: [id], onDelete: Cascade)
  kind        ConsentKind
  /** COMPANY_CONTACTS only: the company the contacts were opened to. */
  companyId   String?
  company     Company?    @relation(fields: [companyId], references: [id])
  /** Edition of the consent text the student agreed to. */
  textVersion String
  givenAt     DateTime    @default(now())
  revokedAt   DateTime?
  ip          String?

  @@index([tenantId, userId, kind])
  @@index([tenantId, kind, revokedAt])
}

/// A certificate the student uploaded; the file is in the private bucket (ilmora-docs). Authenticity is not checked.
model StudentCertificate {
  id          String    @id @default(cuid())
  tenantId    String
  tenant      Tenant    @relation(fields: [tenantId], references: [id])
  userId      String
  user        User      @relation(fields: [userId], references: [id], onDelete: Cascade)
  title       String
  issuer      String?
  issuedAt    DateTime? @db.Date
  fileKey     String
  contentType String
  sizeBytes   Int
  createdAt   DateTime  @default(now())
  updatedAt   DateTime  @updatedAt

  @@index([tenantId, userId])
}

/// «Выпуск»: an institution announces how many graduate in a year, per direction. Student cards are not stored here:
/// they are the institution's confirmed students on the line's direction with graduationYear = year and a current
/// GRADUATE_CARD consent, minus AnnouncementExclusion. A revoked consent therefore hides the card at once.
model GraduationAnnouncement {
  id            String             @id @default(cuid())
  tenantId      String
  tenant        Tenant             @relation(fields: [tenantId], references: [id])
  institutionId String
  institution   Institution        @relation(fields: [institutionId], references: [id])
  year          Int
  status        AnnouncementStatus @default(DRAFT)
  publishedAt   DateTime?
  closedAt      DateTime?
  createdById   String?
  createdAt     DateTime           @default(now())
  updatedAt     DateTime           @updatedAt

  lines           AnnouncementLine[]
  exclusions      AnnouncementExclusion[]
  responses       AnnouncementResponse[]
  contactRequests ContactRequest[]

  @@index([tenantId, status, year])
  @@index([tenantId, institutionId])
}

model AnnouncementLine {
  id             String                 @id @default(cuid())
  announcementId String
  announcement   GraduationAnnouncement @relation(fields: [announcementId], references: [id], onDelete: Cascade)
  directionId    String
  direction      Direction              @relation(fields: [directionId], references: [id])
  count          Int

  responseLines AnnouncementResponseLine[]

  @@unique([announcementId, directionId])
  @@index([directionId])
}

/// A student the institution removed from an announcement.
model AnnouncementExclusion {
  announcementId String
  announcement   GraduationAnnouncement @relation(fields: [announcementId], references: [id], onDelete: Cascade)
  userId         String
  user           User                   @relation(fields: [userId], references: [id], onDelete: Cascade)
  createdAt      DateTime               @default(now())

  @@id([announcementId, userId])
}

/// A company's answer to an announcement: which lines and how many people. One per company and announcement.
model AnnouncementResponse {
  id             String                 @id @default(cuid())
  tenantId       String
  tenant         Tenant                 @relation(fields: [tenantId], references: [id])
  announcementId String
  announcement   GraduationAnnouncement @relation(fields: [announcementId], references: [id])
  companyId      String
  company        Company                @relation(fields: [companyId], references: [id])
  comment        String?
  status         MatchStatus            @default(PENDING)
  decidedAt      DateTime?
  createdAt      DateTime               @default(now())
  updatedAt      DateTime               @updatedAt

  lines AnnouncementResponseLine[]

  @@unique([announcementId, companyId])
  @@index([tenantId, companyId])
  @@index([tenantId, status])
}

model AnnouncementResponseLine {
  responseId  String
  response    AnnouncementResponse @relation(fields: [responseId], references: [id], onDelete: Cascade)
  lineId      String
  line        AnnouncementLine     @relation(fields: [lineId], references: [id], onDelete: Cascade)
  wantedCount Int

  @@id([responseId, lineId])
}

/// «Под обучение»: a company asks for N people trained in a direction by a year, in a region or anywhere.
model TrainingRequest {
  id           String                @id @default(cuid())
  tenantId     String
  tenant       Tenant                @relation(fields: [tenantId], references: [id])
  companyId    String
  company      Company               @relation(fields: [companyId], references: [id])
  directionId  String
  direction    Direction             @relation(fields: [directionId], references: [id])
  count        Int
  byYear       Int
  /** Null = any region. */
  regionId     String?
  region       Region?               @relation(fields: [regionId], references: [id])
  requirements String?
  status       TrainingRequestStatus @default(OPEN)
  closedAt     DateTime?
  createdAt    DateTime              @default(now())
  updatedAt    DateTime              @updatedAt

  offers TrainingOffer[]

  @@index([tenantId, status, directionId])
  @@index([tenantId, companyId])
}

/// An institution's answer to a training request: «подготовим N человек к году Y». One per institution and request.
model TrainingOffer {
  id            String          @id @default(cuid())
  tenantId      String
  tenant        Tenant          @relation(fields: [tenantId], references: [id])
  requestId     String
  request       TrainingRequest @relation(fields: [requestId], references: [id], onDelete: Cascade)
  institutionId String
  institution   Institution     @relation(fields: [institutionId], references: [id])
  count         Int
  byYear        Int
  comment       String?
  status        MatchStatus     @default(PENDING)
  decidedAt     DateTime?
  createdAt     DateTime        @default(now())
  updatedAt     DateTime        @updatedAt

  @@unique([requestId, institutionId])
  @@index([tenantId, institutionId])
}

/// A student asks companies for help with the contract fee; companies see an anonymised card. One open request per
/// student: `openKey` equals userId while the request is ACTIVE or INTERESTED and is null afterwards, and it is unique.
/// The agreement itself is made outside ILMORA; the student marks it here (signedWithCompanyId) for the numbers.
model ContractHelpRequest {
  id                  String             @id @default(cuid())
  tenantId            String
  tenant              Tenant             @relation(fields: [tenantId], references: [id])
  userId              String
  user                User               @relation(fields: [userId], references: [id], onDelete: Cascade)
  motivation          String
  yearsToWork         Int
  /** Null = ready to work in any region. */
  workRegionId        String?
  workRegion          Region?            @relation(fields: [workRegionId], references: [id])
  status              ContractHelpStatus @default(ACTIVE)
  openKey             String?            @unique
  signedWithCompanyId String?
  signedWithCompany   Company?           @relation(fields: [signedWithCompanyId], references: [id])
  signedAt            DateTime?
  withdrawnAt         DateTime?
  createdAt           DateTime           @default(now())
  updatedAt           DateTime           @updatedAt

  contactRequests ContactRequest[]

  @@index([tenantId, status])
  @@index([tenantId, userId])
}

/// A company asks a student to open their contacts. One request per company and student, whatever the source. When
/// the student accepts, the company sees the full card (name, phone, e-mail, certificate files) and a COMPANY_CONTACTS
/// consent row is written.
model ContactRequest {
  id             String                  @id @default(cuid())
  tenantId       String
  tenant         Tenant                  @relation(fields: [tenantId], references: [id])
  companyId      String
  company        Company                 @relation(fields: [companyId], references: [id])
  userId         String
  user           User                    @relation(fields: [userId], references: [id], onDelete: Cascade)
  source         ContactSource
  contractHelpId String?
  contractHelp   ContractHelpRequest?    @relation(fields: [contractHelpId], references: [id])
  announcementId String?
  announcement   GraduationAnnouncement? @relation(fields: [announcementId], references: [id])
  status         MatchStatus             @default(PENDING)
  decidedAt      DateTime?
  createdAt      DateTime                @default(now())
  updatedAt      DateTime                @updatedAt

  @@unique([companyId, userId])
  @@index([tenantId, userId, status])
  @@index([tenantId, companyId, status])
}

/// Practice or internship offered by an approved company (published without a separate review).
model Vacancy {
  id           String        @id @default(cuid())
  tenantId     String
  tenant       Tenant        @relation(fields: [tenantId], references: [id])
  companyId    String
  company      Company       @relation(fields: [companyId], references: [id])
  kind         VacancyKind
  title        String
  regionId     String
  region       Region        @relation(fields: [regionId], references: [id])
  districtId   String?
  district     District?     @relation(fields: [districtId], references: [id])
  address      String?
  format       WorkFormat
  paid         Boolean       @default(false)
  /** Monthly stipend in tiyin, when paid and stated. */
  stipendMinor BigInt?
  /** Free text, e.g. «2 месяца». */
  duration     String?
  seats        Int
  requirements String?
  deadline     DateTime?     @db.Date
  status       VacancyStatus @default(OPEN)
  closedAt     DateTime?
  createdAt    DateTime      @default(now())
  updatedAt    DateTime      @updatedAt

  directions   VacancyDirection[]
  applications VacancyApplication[]

  @@index([tenantId, status, regionId])
  @@index([tenantId, companyId])
}

model VacancyDirection {
  vacancyId   String
  vacancy     Vacancy   @relation(fields: [vacancyId], references: [id], onDelete: Cascade)
  directionId String
  direction   Direction @relation(fields: [directionId], references: [id])

  @@id([vacancyId, directionId])
  @@index([directionId])
}

/// A student's application to a vacancy: the company gets the full card (the button says so). One per vacancy.
model VacancyApplication {
  id              String            @id @default(cuid())
  tenantId        String
  tenant          Tenant            @relation(fields: [tenantId], references: [id])
  vacancyId       String
  vacancy         Vacancy           @relation(fields: [vacancyId], references: [id])
  userId          String
  user            User              @relation(fields: [userId], references: [id], onDelete: Cascade)
  note            String?
  status          ApplicationStatus @default(NEW)
  statusChangedAt DateTime?
  createdAt       DateTime          @default(now())
  updatedAt       DateTime          @updatedAt

  @@unique([vacancyId, userId])
  @@index([tenantId, userId])
  @@index([tenantId, vacancyId, status])
}
