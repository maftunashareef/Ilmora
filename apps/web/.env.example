# ILMORA Web — environment configuration
# Copy to .env.local (development) or set in the hosting environment (see infra/uzcloud/README.md).
# NEVER commit real secret values.

# Public site URL (for canonical URLs, OpenGraph, sitemaps, and metadataBase)
NEXT_PUBLIC_SITE_URL=http://localhost:3000

# Public API URL reached from browser
# In development: http://localhost:4000
# In production with the same-origin rewrite (API_INTERNAL_URL): '/'
NEXT_PUBLIC_API_URL=http://localhost:4000

# Internal API URL (used for Next.js SSR and rewrites when NEXT_PUBLIC_API_URL='/' or in private networks)
#API_INTERNAL_URL=http://localhost:4000

# Optional CDN or public S3 bucket for media images
#NEXT_PUBLIC_MEDIA_BASE_URL=https://media.ilmora.uz

# Offline demo sign-in (a client-only mock session shown when the API cannot be reached).
# Always available in `next dev`; hidden in production builds unless this is exactly "true" (demo deployments only).
#NEXT_PUBLIC_ENABLE_DEMO_LOGIN=true

# Search engine ownership tokens (server-side, read at start-up; each one renders a <meta> tag in <head>).
# Take the "HTML tag" value from each console: Google Search Console, Yandex Webmaster, Bing Webmaster Tools.
#GOOGLE_SITE_VERIFICATION=
#YANDEX_VERIFICATION=
#BING_SITE_VERIFICATION=
