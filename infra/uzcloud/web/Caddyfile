# ILMORA edge (machine ilmora-web). Certificates are issued and renewed by Caddy automatically.
# {$VAR} values come from infra/uzcloud/web/.env through docker-compose.yml.

{
	email {$ACME_EMAIL}
}

(common) {
	encode zstd gzip
	header {
		Strict-Transport-Security "max-age=15552000; includeSubDomains"
		X-Content-Type-Options nosniff
		-Server
	}
}

(api) {
	request_body {
		max_size 2MB
	}
	reverse_proxy api:4000
}

www.{$WEB_DOMAIN} {
	redir https://{$WEB_DOMAIN}{uri} permanent
}

# ---------------- site, student and teacher workspaces ----------------
{$WEB_DOMAIN} {
	import common

	# The admin API answers only on the admin domain.
	handle /v1/admin/* {
		respond 404
	}
	handle /v1/* {
		import api
	}
	# Payme / Click callbacks and health checks live outside the /v1 prefix.
	handle /payments/* {
		import api
	}
	handle /health/* {
		import api
	}
	handle {
		reverse_proxy web:3000
	}
}

# ---------------- admin panel (served by ilmora-admin over the private network) ----------------
{$ADMIN_DOMAIN} {
	import common
	header X-Robots-Tag "noindex, nofollow"

	# ADMIN_ALLOW_IPS: office / owner addresses, space separated. "0.0.0.0/0 ::/0" leaves it open (login still required).
	@outsider not remote_ip {$ADMIN_ALLOW_IPS}
	handle @outsider {
		respond 403
	}
	handle /v1/* {
		import api
	}
	handle {
		reverse_proxy {$ADMIN_PRIVATE_IP}:3000
	}
}
