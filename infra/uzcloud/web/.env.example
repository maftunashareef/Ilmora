# ilmora-web — copy to infra/uzcloud/web/.env on the machine (chmod 600). Never commit the real file.
# Application settings shared with ilmora-admin live in infra/uzcloud/api.env (see api.env.example).

# ---- UzCloud private network addresses ----
WEB_PRIVATE_IP=10.0.1.10
ADMIN_PRIVATE_IP=10.0.1.20

# ---- domains and HTTPS ----
WEB_DOMAIN=ilmora.uz
ADMIN_DOMAIN=admin.ilmora.uz
ACME_EMAIL=
# Who may open the admin domain (space separated IPs / CIDRs). "0.0.0.0/0 ::/0" = anyone (login still required).
ADMIN_ALLOW_IPS=0.0.0.0/0 ::/0

# ---- images (the deploy workflow rewrites these lines with exact digests) ----
API_IMAGE=
WEB_IMAGE=

# ---- database and Redis on ilmora-admin: the same values as infra/uzcloud/admin/.env ----
POSTGRES_USER=ilmora
POSTGRES_PASSWORD=
POSTGRES_DB=ilmora
REDIS_PASSWORD=
