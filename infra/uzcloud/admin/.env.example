# ilmora-admin — copy to infra/uzcloud/admin/.env on the machine (chmod 600). Never commit the real file.
# Application settings shared with ilmora-web live in infra/uzcloud/api.env (see api.env.example).

# ---- UzCloud private network addresses ----
WEB_PRIVATE_IP=10.0.1.10
ADMIN_PRIVATE_IP=10.0.1.20

# ---- images (the deploy workflow rewrites these lines with exact digests) ----
API_IMAGE=
API_IMAGE_MIGRATOR=
WEB_IMAGE=

# ---- database and Redis: the same values as infra/uzcloud/web/.env ----
# Use hex passwords (openssl rand -hex 32): they go into connection URLs unescaped.
POSTGRES_USER=ilmora
POSTGRES_PASSWORD=
POSTGRES_DB=ilmora
REDIS_PASSWORD=

# ---- backups to UzCloud Object Storage (Cold bucket, backups only) ----
BACKUP_S3_ENDPOINT=https://s3.uzcstorage.uz
BACKUP_S3_BUCKET=ilmora-backups
BACKUP_S3_ACCESS_KEY_ID=
BACKUP_S3_SECRET_ACCESS_KEY=
# Encrypts every dump. Keep a copy OUTSIDE the servers (password manager): without it the backups are useless.
BACKUP_PASSPHRASE=
BACKUP_RETENTION_DAYS=90
# 22:40 UTC = 03:40 Tashkent
BACKUP_AT_UTC=22:40
# Optional: Healthchecks.io ping URL; a missed ping means the night's backup did not happen.
BACKUP_PING_URL=
