# ILMORA settings and secrets shared by both machines: read by docker compose (compose.sh) and by the api, worker and
# migrator containers. Copy to infra/uzcloud/api.env on BOTH machines with identical content (chmod 600):
#   scp -3 ilmora-admin:/opt/ilmora/infra/uzcloud/api.env ilmora-web:/opt/ilmora/infra/uzcloud/api.env
# Never commit the real file, never paste it into a chat. Every app option with its default: apps/api/.env.example.
# DATABASE_URL, REDIS_URL, APP_ROLE and NODE_ENV are built per machine by docker-compose.yml, not here.

# ---- database and Redis (on ilmora-admin; ilmora-web connects over the private network) ----
# Hex passwords (openssl rand -hex 32): they go into connection URLs unescaped.
POSTGRES_USER=ilmora
POSTGRES_PASSWORD=
POSTGRES_DB=ilmora
REDIS_PASSWORD=

# ---- application ----

PUBLIC_API_URL=https://ilmoraa.uz
PUBLIC_WEB_URL=https://ilmoraa.uz
CORS_ORIGINS=https://ilmoraa.uz,https://admin.ilmoraa.uz
COOKIE_SECURE=true
LOG_LEVEL=info

# Seed (first release): false = no sample centers, teachers or courses; admins enter the real catalog.
SEED_CATALOG=false

# Generate each on the server: openssl rand -hex 32
JWT_ACCESS_SECRET=
OTP_JOB_ENCRYPTION_KEY=
# Encrypts the authenticator-app secrets of the ministry and the Super Admins. Without it the ministry cannot sign in
# and the Super Admins sign in with the password only, so the API refuses to start without it (openssl rand -base64 32).
# Never change it once set: the linked apps would stop working. Keep a copy with the database backup.
TOTP_ENCRYPTION_KEY=
# Key of the graduate cards' ids companies see (openssl rand -base64 32). Changing it only changes ids on open cards.
CARD_ID_SECRET=

# SMS. Launch without an Eskiz contract: sign-in is login + password, so SMS is not required; the console provider
# only writes messages to the api/worker logs on these machines. With the Eskiz account: SMS_PROVIDER=eskiz,
# fill ESKIZ_EMAIL / ESKIZ_PASSWORD and delete SMS_ALLOW_CONSOLE_IN_PRODUCTION.
SMS_PROVIDER=console
SMS_ALLOW_CONSOLE_IN_PRODUCTION=true
SMS_SENDER=ILMORA
#ESKIZ_EMAIL=
#ESKIZ_PASSWORD=

# ---- Payme ----  (Click was removed on 10.11.2026: its CLICK_* variables are no longer read)
# The payment code is fully built; a provider's "Pay" button appears on the site only once its keys below are set.
# Credentials are issued by Payme after a merchant contract on your legal entity + bank account. Secrets:
# fill them straight on the server, never commit them, never paste them into a chat. Full steps: docs/payments/onboarding-checklist.md.
#
# Payme (Paycom), from the merchant cabinet. Give Payme this Merchant API endpoint to call:
#   https://ilmoraa.uz/payments/payme      (no /v1: the callbacks live outside the API prefix)
#PAYME_MERCHANT_ID=          # "Кассa ID" of your Payme cash register
#PAYME_KEY=                  # production key of the cash register (X-Auth password)
#PAYME_TEST_KEY=             # sandbox key; ignored when NODE_ENV=production (as on these machines), see the checklist
#PAYME_SANDBOX_PAYMENT_IDS=  # Payme acceptance tests only: test orders the test key may reach on production; clear afterwards
#PAYME_ALLOWED_IPS=          # optional allow-list of Payme source IPs, comma-separated. Payme's published list:
#PAYME_ALLOWED_IPS=185.234.113.1,185.234.113.2,185.234.113.3,185.234.113.4,185.234.113.5,185.234.113.6,185.234.113.7,185.234.113.8,185.234.113.9,185.234.113.10,185.234.113.11,185.234.113.12,185.234.113.13,185.234.113.14,185.234.113.15
# Fiscal receipt sent to Payme in CheckPerformTransaction (one line for the whole amount). The code has defaults; set
# the ИКПУ (MXIK) and package code of ILMORA's service from tasnif.soliq.uz, and the VAT rate of your tax regime
# (0 when not a VAT payer, 12 when you are) — confirm all three with your accountant before going live.
#PAYME_FISCAL_IKPU=          # 17-digit ИКПУ / MXIK code of the service
#PAYME_FISCAL_PACKAGE_CODE=  # package (unit) code listed for that ИКПУ
#PAYME_FISCAL_VAT_PERCENT=0

# Media (UzCloud Object Storage, Standard class bucket — not the Cold backup bucket).
#S3_ENDPOINT=https://s3.uzcstorage.uz
#S3_BUCKET=ilmora-media
# Private documents (company and student certificates): its own bucket WITHOUT public read; CORS allows PUT from the site.
#S3_DOCS_BUCKET=ilmora-docs
# Homework archives (ZIP up to 1024 MB, ТЗ 18.11, 8.4): private bucket, NOT in backups; CORS allows PUT from the site.
#S3_HOMEWORK_BUCKET=ilmora-homework
#S3_ACCESS_KEY_ID=
#S3_SECRET_ACCESS_KEY=
S3_FORCE_PATH_STYLE=true

# Sentry sends error reports abroad. Leave empty to keep all data inside Uzbekistan.
#SENTRY_DSN=
