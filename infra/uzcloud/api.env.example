# ILMORA API settings shared by the api (ilmora-web) and the worker (ilmora-admin).
# Copy to infra/uzcloud/api.env on BOTH machines with identical content (chmod 600). Never commit the real file.
# DATABASE_URL, REDIS_URL, APP_ROLE and NODE_ENV are set per machine by docker-compose.yml, not here.
# Every option with its default: apps/api/.env.example.

PUBLIC_API_URL=https://ilmora.uz
PUBLIC_WEB_URL=https://ilmora.uz
CORS_ORIGINS=https://ilmora.uz,https://admin.ilmora.uz
COOKIE_SECURE=true
LOG_LEVEL=info

# node -e "console.log(require('crypto').randomBytes(48).toString('base64'))"
JWT_ACCESS_SECRET=
OTP_JOB_ENCRYPTION_KEY=

# SMS (eskiz | http). console is refused in production unless SMS_ALLOW_CONSOLE_IN_PRODUCTION=true.
SMS_PROVIDER=eskiz
SMS_SENDER=ILMORA
#ESKIZ_EMAIL=
#ESKIZ_PASSWORD=

# Payme / Click — leave empty until the merchant credentials are issued.
#PAYME_MERCHANT_ID=
#PAYME_KEY=
#PAYME_ALLOWED_IPS=
#CLICK_SERVICE_ID=
#CLICK_MERCHANT_ID=
#CLICK_MERCHANT_USER_ID=
#CLICK_SECRET_KEY=
#CLICK_ALLOWED_IPS=

# Media (UzCloud Object Storage, Standard class bucket — not the Cold backup bucket).
#S3_ENDPOINT=https://s3.uzcstorage.uz
#S3_BUCKET=ilmora-media
#S3_ACCESS_KEY_ID=
#S3_SECRET_ACCESS_KEY=
S3_FORCE_PATH_STYLE=true

# Sentry sends error reports abroad. Leave empty to keep all data inside Uzbekistan.
#SENTRY_DSN=
