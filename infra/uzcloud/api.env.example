# ILMORA settings and secrets shared by both machines: read by docker compose (compose.sh) and by the api, worker and
# migrator containers. Copy to infra/uzcloud/api.env on BOTH machines with identical content (chmod 600):
#   scp -3 ilmora-admin:/opt/ilmora/infra/uzcloud/api.env ilmora-web:/opt/ilmora/infra/uzcloud/api.env
# Never commit the real file, never paste it into a chat. Every app option with its default: apps/api/.env.example.
# DATABASE_URL, REDIS_URL, APP_ROLE and NODE_ENV are built per machine by docker-compose.yml, not here.

# ---- database and Redis (on ilmora-admin; ilmora-web connects over the private network) ----
# Hex passwords (openssl rand -hex 32): they go into connection URLs unescaped.
POSTGRES_USER=ilmora
POSTGRES_PASSWORD=
POSTGRES_DB=ilmora
REDIS_PASSWORD=

# ---- application ----

PUBLIC_API_URL=https://ilmoraa.uz
PUBLIC_WEB_URL=https://ilmoraa.uz
CORS_ORIGINS=https://ilmoraa.uz,https://admin.ilmoraa.uz
COOKIE_SECURE=true
LOG_LEVEL=info

# Seed (first release): false = no sample centers, teachers or courses; admins enter the real catalog.
SEED_CATALOG=false

# Generate each on the server: openssl rand -hex 32
JWT_ACCESS_SECRET=
OTP_JOB_ENCRYPTION_KEY=

# SMS. Launch without an Eskiz contract: sign-in is login + password, so SMS is not required; the console provider
# only writes messages to the api/worker logs on these machines. With the Eskiz account: SMS_PROVIDER=eskiz,
# fill ESKIZ_EMAIL / ESKIZ_PASSWORD and delete SMS_ALLOW_CONSOLE_IN_PRODUCTION.
SMS_PROVIDER=console
SMS_ALLOW_CONSOLE_IN_PRODUCTION=true
SMS_SENDER=ILMORA
#ESKIZ_EMAIL=
#ESKIZ_PASSWORD=

# Payme / Click — leave empty until the merchant credentials are issued.
#PAYME_MERCHANT_ID=
#PAYME_KEY=
#PAYME_ALLOWED_IPS=
#CLICK_SERVICE_ID=
#CLICK_MERCHANT_ID=
#CLICK_MERCHANT_USER_ID=
#CLICK_SECRET_KEY=
#CLICK_ALLOWED_IPS=

# Media (UzCloud Object Storage, Standard class bucket — not the Cold backup bucket).
#S3_ENDPOINT=https://s3.uzcstorage.uz
#S3_BUCKET=ilmora-media
#S3_ACCESS_KEY_ID=
#S3_SECRET_ACCESS_KEY=
S3_FORCE_PATH_STYLE=true

# Sentry sends error reports abroad. Leave empty to keep all data inside Uzbekistan.
#SENTRY_DSN=
