# Rendered by the nginx image's envsubst from WEB_DOMAIN / API_DOMAIN.

# Plain HTTP: ACME challenge + redirect to HTTPS. /healthz lets the compose healthcheck work without TLS.
server {
    listen 80;
    server_name ${WEB_DOMAIN} www.${WEB_DOMAIN} ${API_DOMAIN};
    location /.well-known/acme-challenge/ { root /var/www/certbot; }
    location = /healthz { return 200 'ok'; add_header Content-Type text/plain; }
    location / { return 301 https://$host$request_uri; }
}

# ---------------- web (Next.js) ----------------
server {
    listen 443 ssl;
    http2 on;
    server_name ${WEB_DOMAIN} www.${WEB_DOMAIN};

    ssl_certificate     /etc/letsencrypt/live/${WEB_DOMAIN}/fullchain.pem;
    ssl_certificate_key /etc/letsencrypt/live/${WEB_DOMAIN}/privkey.pem;
    include /etc/nginx/conf.d/ssl-params.inc;

    add_header Strict-Transport-Security "max-age=15552000; includeSubDomains" always;
    add_header X-Content-Type-Options nosniff always;
    add_header Referrer-Policy strict-origin-when-cross-origin always;
    add_header Permissions-Policy "camera=(self), microphone=(), geolocation=()" always;

    limit_conn conn_per_ip 40;

    location /_next/static/ {
        proxy_pass http://web:3000;
        proxy_set_header Host $host;
        expires 365d;
        add_header Cache-Control "public, max-age=31536000, immutable";
    }

    location / {
        proxy_pass http://web:3000;
        proxy_http_version 1.1;
        proxy_set_header Host $host;
        proxy_set_header X-Real-IP $remote_addr;
        proxy_set_header X-Forwarded-For $proxy_add_x_forwarded_for;
        proxy_set_header X-Forwarded-Proto https;
        proxy_read_timeout 60s;
    }
}

# ---------------- api (NestJS) ----------------
server {
    listen 443 ssl;
    http2 on;
    server_name ${API_DOMAIN};

    ssl_certificate     /etc/letsencrypt/live/${WEB_DOMAIN}/fullchain.pem;
    ssl_certificate_key /etc/letsencrypt/live/${WEB_DOMAIN}/privkey.pem;
    include /etc/nginx/conf.d/ssl-params.inc;

    add_header Strict-Transport-Security "max-age=15552000; includeSubDomains" always;
    add_header X-Content-Type-Options nosniff always;

    limit_conn conn_per_ip 60;
    client_max_body_size 2m;

    # Stricter edge limit for OTP endpoints (application throttling applies on top).
    location ~ ^/v1/auth/otp/ {
        limit_req zone=api_auth burst=5 nodelay;
        proxy_pass http://api:4000;
        include /etc/nginx/conf.d/proxy-params.inc;
    }

    # Server-sent events: no buffering, long read timeout.
    location ~ ^/v1/teacher/sessions/[^/]+/stream$ {
        proxy_pass http://api:4000;
        include /etc/nginx/conf.d/proxy-params.inc;
        proxy_buffering off;
        proxy_cache off;
        proxy_read_timeout 3600s;
        chunked_transfer_encoding off;
    }

    # Payment provider callbacks: no rate limit by IP (providers call from few addresses), short timeouts.
    location ~ ^/payments/ {
        proxy_pass http://api:4000;
        include /etc/nginx/conf.d/proxy-params.inc;
        proxy_read_timeout 30s;
    }

    location / {
        limit_req zone=api_general burst=60 nodelay;
        proxy_pass http://api:4000;
        include /etc/nginx/conf.d/proxy-params.inc;
    }
}
